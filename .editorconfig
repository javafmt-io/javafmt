root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
max_line_length = 150
ij_continuation_indent_size = 8
ij_wrap_on_typing = false

[*.{kts,kt}]
indent_size = 4

[*.toml]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
