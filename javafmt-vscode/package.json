{
  "name": "javafmt",
  "displayName": "javafmt",
  "description": "An opinionated Java formatter — fast, deterministic, 150-char line width.",
  "version": "0.1.0",
  "publisher": "javafmt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javafmt-io/javafmt"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "javafmt.restartDaemon",
        "title": "javafmt: Restart Daemon"
      }
    ],
    "configuration": {
      "title": "javafmt",
      "properties": {
        "javafmt.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable javafmt as the formatter for Java files."
        },
        "javafmt.javaExecutable": {
          "type": "string",
          "default": "java",
          "description": "Path to the Java executable used to launch the daemon."
        },
        "javafmt.daemonJar": {
          "type": "string",
          "default": "",
          "description": "Override path to javafmt-daemon.jar. Defaults to the bundled jar. Setting this bypasses bundled native-binary detection entirely, even if one is present."
        },
        "javafmt.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Format Java files on save. Shorthand for setting editor.formatOnSave and [java].editor.defaultFormatter yourself."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "package": "vsce package --out build/javafmt-vscode.vsix",
    "package:target": "vsce package --target",
    "test": "jest --json --outputFile=build/test-results.json",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0",
    "mocha": "^12.0.3"
  }
}
