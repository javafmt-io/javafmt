{
  "name": "javafmt",
  "displayName": "javafmt",
  "description": "An opinionated Java formatter — fast, deterministic, 150-char line width.",
  "version": "0.1.0",
  "publisher": "javafmt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javafmt-io/javafmt"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "javafmt.restartDaemon",
        "title": "javafmt: Restart Daemon"
      }
    ],
    "configuration": {
      "title": "javafmt",
      "properties": {
        "javafmt.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable javafmt as the formatter for Java files."
        },
        "javafmt.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to a javafmt binary to use instead of the one bundled with the extension. When empty, the bundled binary is used, or else the first javafmt on PATH. The extension starts it once as a long-lived `javafmt --daemon` process."
        }
      }
    }
  },
  "scripts": {
    "generate": "buf generate build/daemon-proto --template buf.gen.yaml",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "package": "vsce package --out build/javafmt-vscode.vsix",
    "package:target": "vsce package --target",
    "test": "jest --json --outputFile=build/test-results.json",
    "test:integration": "vscode-test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0",
    "mocha": "^12.0.3"
  }
}
